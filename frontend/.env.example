# Supabase (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL of the deployed litmus-backend app (Netlify Functions / Next.js API routes)
NEXT_PUBLIC_BACKEND_URL=https://api.litimus.app

# Paddle (payments) — all public/client-side, safe for the browser. Get the
# client-side token and price ids from the Paddle dashboard (Developer tools
# > Authentication for the token; Catalog > Products for each price id).
# Use "sandbox" while testing against a Paddle sandbox account.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-paddle-client-side-token
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_STUDENT=pri_your_student_price_id
NEXT_PUBLIC_PADDLE_PRICE_PRO=pri_your_pro_price_id
NEXT_PUBLIC_PADDLE_PRICE_TEAM=pri_your_team_price_id
NEXT_PUBLIC_PADDLE_PRICE_DAYPASS=pri_your_daypass_price_id
