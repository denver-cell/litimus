# Supabase — service role key, server-only, never expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paddle — webhook signing secret (from the notification destination you
# create in the Paddle dashboard, pointed at
# {this app's public URL}/api/billing/paddle/webhook), plus the same price
# ids the frontend uses (NEXT_PUBLIC_PADDLE_PRICE_* in frontend/.env.local) —
# needed here too, to map an incoming webhook's price id back to a plan.
PADDLE_WEBHOOK_SECRET=your-paddle-notification-destination-secret
PADDLE_PRICE_STUDENT=pri_your_student_price_id
PADDLE_PRICE_PRO=pri_your_pro_price_id
PADDLE_PRICE_TEAM=pri_your_team_price_id
PADDLE_PRICE_DAYPASS=pri_your_daypass_price_id
